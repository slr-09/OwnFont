default_platform(:ios)

platform :ios do
  desc "Build and upload to TestFlight"
  lane :beta do
    setup_ci

    # 인증서 & 프로비저닝 프로파일 설치
    import_certificate(
      certificate_path: "cert.p12",
      certificate_password: ENV["CERT_P12_PASSWORD"],
      keychain_name: "fastlane_tmp",
      keychain_password: "fastlane_tmp"
    )
    install_provisioning_profile(path: "profile.mobileprovision")
    update_code_signing_settings(
      use_automatic_signing: false,
      path: "OwnFont.xcodeproj"
    )

    # 빌드 번호를 GitHub run number로 설정
    increment_build_number(
      build_number: ENV["BUILD_NUMBER"],
      xcodeproj: "OwnFont.xcodeproj"
    )

    build_app(
      project: "OwnFont.xcodeproj",
      scheme: "OwnFont",
      export_method: "app-store",
      export_options: {
        provisioningProfiles: {
          "com.siro.OwnFont" => "OwnFont_AppStore"
        }
      }
    )

    upload_to_testflight(
      api_key_path: "fastlane/asc_api_key.json",
      skip_waiting_for_build_processing: true
    )
  end
end
